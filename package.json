{
  "name": "achromatic-anamnesis-sciopticon",
  "private": true,
  "version": "0.1.0",
  "description": "AchromaticAnamnesisSciopticon MIDI piano roll practice app for Web MIDI input.",
  "desktopName": "AchromaticAnamnesisSciopticon",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "copy:audio-worklet": "node scripts/copy-spessasynth-worklet.mjs",
    "predev": "npm run copy:audio-worklet",
    "dev": "vite",
    "prebuild": "npm run copy:audio-worklet",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "desktop:dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm run dev -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev-server=http://127.0.0.1:5173\"",
    "desktop:preview": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.local.achromatic-anamnesis-sciopticon",
    "productName": "AchromaticAnamnesisSciopticon",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "mac": {
      "category": "public.app-category.music"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "spessasynth_core": "^4.3.12",
    "spessasynth_lib": "^4.3.8",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.10"
  }
}
